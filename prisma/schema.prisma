generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used at runtime by the serverless app.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations, which the pooler
  // can't run. Neon/Supabase/Vercel all expose both strings.
  directUrl = env("DIRECT_URL")
}

enum Category {
  FOUNDATION
  BLUSH
  BRONZER
  HIGHLIGHTER
  EYESHADOW
  LIPSTICK
  SETTING_POWDER
}

model Product {
  id       String   @id @default(cuid())
  category Category
  name     String
  brand    String
  shade    String
  colorHex String
  // Postgres stores this as NUMERIC, giving exact fixed-point Decimal semantics.
  price    Decimal
  coverage String
  finish   String
  skinType String
  desc     String
}

model SavedLook {
  id        String   @id @default(cuid())
  name      String
  layers    Json
  createdAt DateTime @default(now())
}
